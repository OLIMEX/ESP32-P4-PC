# ESP32-P4-PC board demo defaults, validated with ESP-IDF v5.5.x.
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# The demo drives LVGL synchronously and initializes the Ethernet/lwIP stack
# from app_main.  ESP-IDF's 3584-byte default main-task stack is too small for
# the deepest display/network path.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ESP32-P4-PC memory and image layout.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y

# HDMI through the onboard LT8912B bridge. 1280x720 preserves the 16:9 aspect
# ratio of Full HD displays and uses the ESP32-P4's exact 80 MHz DPI clock.
# RGB888 and a single framebuffer keep PSRAM bandwidth predictable.
CONFIG_BSP_I2C_NUM=1
CONFIG_BSP_I2C_FAST_MODE=y
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=1
CONFIG_BSP_LCD_COLOR_FORMAT_RGB888=y
CONFIG_BSP_LCD_TYPE_HDMI=y
CONFIG_BSP_LCD_HDMI_1280x720_60HZ=y
CONFIG_BSP_LCD_USE_DMA2D=y
# CONFIG_BSP_LCD_HDMI_EXPERIMENTAL_MODES is not set

# BOOT/operator button. GPIO35 is shared with RMII TXD1 and is released before
# Ethernet starts.
CONFIG_PT_BTN_GPIO=35
CONFIG_PT_BTN_ACTIVE_LOW=y
# CONFIG_PT_BTN_PULLUP is not set
# CONFIG_PT_BTN_PULLDOWN is not set
CONFIG_PT_BTN_LONGPRESS_MS=2000
CONFIG_PT_DISPLAY_INIT_DELAY_MS=300

# Native four-bit SDMMC interface. 20 MHz is the normal conservative operating
# frequency; 400 kHz is an initialization/debug rate, not a useful speed test.
CONFIG_SD_TEST_INIT_DELAY_MS=100
CONFIG_SD_TEST_RETRY_COUNT=3
CONFIG_SD_TEST_MAX_FREQ_KHZ=20000
CONFIG_SD_TEST_BUS_WIDTH=4
CONFIG_SD_TEST_PWR_GPIO=45
CONFIG_SD_TEST_PWR_ON_LEVEL=0
CONFIG_SD_TEST_USE_ONCHIP_LDO=y
CONFIG_SD_TEST_LDO_CHAN_ID=4
CONFIG_SD_TEST_PIN_CLK=43
CONFIG_SD_TEST_PIN_CMD=44
CONFIG_SD_TEST_PIN_D0=39
CONFIG_SD_TEST_PIN_D1=40
CONFIG_SD_TEST_PIN_D2=41
CONFIG_SD_TEST_PIN_D3=42
CONFIG_SD_TEST_PIN_CD=-1
CONFIG_SD_TEST_PIN_WP=-1

# The board's four USB-A host sockets are all downstream of its FE1.1s hub.
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_USB_HOST_HUB_MULTI_LEVEL=y

# ES8311 audio codec and I2S signals.
CONFIG_AUDIO_TEST_I2C_PORT=0
CONFIG_AUDIO_TEST_I2C_SDA_GPIO=7
CONFIG_AUDIO_TEST_I2C_SCL_GPIO=8
CONFIG_AUDIO_TEST_I2C_FREQ_HZ=400000
CONFIG_AUDIO_TEST_I2S_PORT=0
CONFIG_AUDIO_TEST_I2S_MCLK_GPIO=13
CONFIG_AUDIO_TEST_I2S_DOUT_GPIO=11
CONFIG_AUDIO_TEST_I2S_BCLK_GPIO=12
CONFIG_AUDIO_TEST_I2S_DIN_GPIO=9
CONFIG_AUDIO_TEST_I2S_WS_GPIO=10
CONFIG_AUDIO_TEST_CODEC_PWR_GPIO=6
CONFIG_AUDIO_TEST_CODEC_PWR_ACTIVE_HIGH=y
CONFIG_AUDIO_TEST_CODEC_PWR_DEFAULT_INPUT=y
CONFIG_AUDIO_TEST_SAMPLE_RATE=16000
CONFIG_AUDIO_TEST_BITS_PER_SAMPLE=16
CONFIG_AUDIO_TEST_CHANNELS=1
CONFIG_AUDIO_TEST_DMA_FRAME_SAMPLES=256
CONFIG_AUDIO_TEST_TASK_STACK=4096
CONFIG_AUDIO_TEST_TASK_PRIO=12

# IP101 Ethernet PHY. Internet ping is optional and configurable.
CONFIG_LAN_TEST_PHY_ADDR=1
CONFIG_LAN_TEST_PHY_RST_GPIO=51
CONFIG_LAN_TEST_MDC_GPIO=31
CONFIG_LAN_TEST_MDIO_GPIO=52
CONFIG_LAN_TEST_RMII_CLK_IN_GPIO=50
CONFIG_LAN_TEST_DHCP_TIMEOUT_MS=20000
CONFIG_LAN_TEST_PING_TARGET="8.8.8.8"
